<%
  brand_name = global_config['BRAND_NAME'] || 'Chatwoot'
  recipient_name = @resource.name.presence || @resource.email
  account_user = @resource&.account_users&.first
  inviter = account_user&.inviter
  account_name = account_user&.account&.name
  is_saml_account = account_user&.account&.saml_enabled?
  invited_user = inviter.present? && @resource.unconfirmed_email.blank?

  eyebrow = 'Benvenuto'
  heading = 'Conferma la tua email per iniziare'
  intro_text =
    "Benvenuto su #{brand_name}! Abbiamo preparato per te una suite di strumenti potenti da esplorare."
  supporting_text =
    'Prima di iniziare, dobbiamo verificare il tuo indirizzo email. Fai clic sul pulsante qui sotto per attivare il tuo account.'
  action_text = 'Conferma il mio account'
  action_url = frontend_url('auth/confirmation', confirmation_token: @token)
  info_title = nil
  info_text = nil
  detail_rows = []
  detail_rows << ['Nuova email', @resource.unconfirmed_email] if @resource.unconfirmed_email.present?

  if @resource.unconfirmed_email.present?
    eyebrow = 'Aggiornamento email'
    heading = 'Conferma il tuo nuovo indirizzo email'
    intro_text = "Abbiamo ricevuto una richiesta per aggiornare l'indirizzo email del tuo account #{brand_name}."
    supporting_text = 'Conferma il nuovo indirizzo qui sotto per completare la modifica.'
    action_text = 'Conferma indirizzo email'
  elsif @resource.confirmed?
    eyebrow = 'Account pronto'

    if is_saml_account
      heading = 'Il tuo accesso è pronto'
      intro_text = "Il tuo accesso a #{brand_name} è già configurato."
      supporting_text = "Usa il portale Single Sign-On (SSO) della tua organizzazione per accedere a #{brand_name}."
      action_text = nil
      action_url = nil
      info_title = 'Accedi con il SSO della tua organizzazione'
      info_text =
        "Non ti serve una password separata per #{brand_name}. Parti dal portale del provider di identità aziendale."
      detail_rows = []
      detail_rows << ['Workspace', account_name] if account_name.present?
      detail_rows << ['Metodo di accesso', 'Single Sign-On (SSO)']
    else
      heading = 'Il tuo account è pronto'
      intro_text = "Il tuo account #{brand_name} è già attivo."
      supporting_text = 'Usa il pulsante qui sotto per accedere e riprendere da dove avevi lasciato.'
      action_text = 'Accedi al mio account'
      action_url = frontend_url('auth/sign_in')
      detail_rows = []
    end
  elsif invited_user
    eyebrow = 'Invito al workspace'
    heading =
      if account_name.present?
        "Sei stato invitato a unirti a #{account_name}"
      else
        "Sei stato invitato a provare #{brand_name}"
      end

    if is_saml_account
      intro_text = if account_name.present?
        "#{inviter.name}, di #{account_name}, ti ha invitato ad accedere a #{brand_name}."
      else
        "#{inviter.name} ti ha invitato ad accedere a #{brand_name}."
      end
      supporting_text =
        'La tua organizzazione usa Single Sign-On (SSO), quindi non dovrai creare una password separata.'
      action_text = nil
      action_url = nil
      info_title = 'Usa il portale SSO della tua organizzazione'
      info_text = "Continua dal portale del provider di identità aziendale per accedere a #{brand_name}."
      detail_rows = [['Invitato da', inviter.name]]
      detail_rows << ['Workspace', account_name] if account_name.present?
      detail_rows << ['Metodo di accesso', 'Single Sign-On (SSO)']
    else
      intro_text = if account_name.present?
        "#{inviter.name}, di #{account_name}, ti ha invitato a provare #{brand_name}."
      else
        "#{inviter.name} ti ha invitato a provare #{brand_name}."
      end
      supporting_text = 'Crea il tuo account per iniziare a collaborare con il tuo team.'
      action_text = 'Conferma il mio account'
      action_url = frontend_url(
        'auth/password/edit',
        reset_password_token: @resource.send(:set_reset_password_token)
      )
      detail_rows = [['Invitato da', inviter.name]]
      detail_rows << ['Workspace', account_name] if account_name.present?
    end
  end
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: action_text,
  action_url: action_url,
  detail_rows: detail_rows,
  eyebrow: eyebrow,
  heading: heading,
  info_text: info_text,
  info_title: info_title,
  intro_text: intro_text,
  recipient_name: recipient_name,
  supporting_text: supporting_text
} %>
